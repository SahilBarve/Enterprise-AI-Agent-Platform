# Environment Configuration for Enterprise AI Operations Platform
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_NAME=ai-operations-platform

# API Gateway
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8000
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=aiops
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/aiops

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379/0

# RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# Qdrant Vector DB
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Object Storage (MinIO local / AWS S3)
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET_NAME=aiops-storage
S3_REGION=us-east-1

# OpenTelemetry & Observability
OTEL_SERVICE_NAME=aiops-gateway
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_EXPORTER_OTLP_INSECURE=true
PROMETHEUS_METRICS_PATH=/metrics

# Langfuse Observability (Self-hosted)
LANGFUSE_HOST=http://localhost:3001
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# LLM Providers (OpenAI & Ollama Fallback)
OPENAI_API_KEY=
OPENAI_MODEL_PRIMARY=gpt-4o
OPENAI_MODEL_FAST=gpt-4o-mini
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL_FALLBACK=llama3.2:latest

# Security & Governance
JWT_SECRET_KEY=dev-secret-change-in-production-must-be-32-chars-min
JWT_ALGORITHM=HS256
APPROVAL_TOKEN_SECRET=dev-approval-secret-key-32-chars-long
